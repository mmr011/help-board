{
  "compilerOptions": {
    "strict": true,
    "target": "es6",
    "module": "CommonJS",
    "rootDir": "src/",
    "outDir": "build/",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": [
      "esnext"
    ],
    "moduleResolution": "Node",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true
  }
}
